# ==============================================================================
# CHEFU QUANTUM ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# ── Public App & Service URLs (Exposed to browser) ──
NEXT_PUBLIC_API_BASE_URL=https://api.chefu.co.za
CHEFU_API_BASE_URL=https://api.chefu.co.za
NEXT_PUBLIC_CHEFU_ACCOUNT_URL=https://myaccount.chefu.co.za
NEXT_PUBLIC_QUANTUM_APP_URL=https://quantum.chefu.co.za
NEXT_PUBLIC_QUANTUM_MOBILE_SCHEME=quantum
NEXT_PUBLIC_QUANTUM_ANDROID_PACKAGE=co.za.chefu.quantum

# ── Google Gemini AI (Server-only secret: NEVER prefix with NEXT_PUBLIC_) ──
# Required: The application will fail safely if this key is not configured.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
QUANTUM_GEMINI_MODEL_FLASH=gemini-2.5-flash
QUANTUM_GEMINI_MODEL_PRO=gemini-2.5-flash
QUANTUM_GEMINI_MODEL_ULTRA=gemini-2.5-pro

# ── Generation Limits & Thinking Budgets ──
QUANTUM_MAX_OUTPUT_TOKENS=1200
QUANTUM_GEMINI_THINKING_BUDGET_FLASH=512
QUANTUM_GEMINI_THINKING_BUDGET_PRO=1024
QUANTUM_GEMINI_THINKING_BUDGET_ULTRA=2048
QUANTUM_GEMINI_SERVICE_TIER=standard

# ── Optional Search & Caching ──
QUANTUM_GEMINI_FILE_SEARCH_STORES=
QUANTUM_GEMINI_CACHED_CONTENT=
QUANTUM_GEMINI_IMAGE_MODEL=

# ── Optional Distributed Rate Limiting (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
